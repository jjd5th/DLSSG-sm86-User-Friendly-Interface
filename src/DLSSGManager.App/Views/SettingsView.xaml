<UserControl x:Class="DLSSGManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Title}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Discovery" FontSize="18"/>
                    <CheckBox Content="Scan on startup" IsChecked="{Binding Settings.ScanOnStartup}"/>
                    <CheckBox Content="Steam" IsChecked="{Binding Settings.DiscoverSteam}"/>
                    <CheckBox Content="Epic Games" IsChecked="{Binding Settings.DiscoverEpic}"/>
                    <CheckBox Content="GOG Galaxy" IsChecked="{Binding Settings.DiscoverGog}"/>
                    <CheckBox Content="Xbox / Microsoft Store" IsChecked="{Binding Settings.DiscoverXbox}"/>
                    <CheckBox Content="EA App" IsChecked="{Binding Settings.DiscoverEa}"/>
                    <CheckBox Content="Ubisoft Connect" IsChecked="{Binding Settings.DiscoverUbisoft}"/>
                    <CheckBox Content="Battle.net" IsChecked="{Binding Settings.DiscoverBattleNet}"/>
                    <TextBlock Text="Custom folders" Margin="0,8,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveFolderCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}"/>
                        <ListBox Height="90" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Updates" FontSize="18"/>
                    <CheckBox Content="Check GitHub on startup" IsChecked="{Binding Settings.CheckUpdatesOnStartup}"/>
                    <CheckBox Content="Include prerelease mod builds" IsChecked="{Binding Settings.IncludePrerelease}"/>
                    <TextBlock Text="Pinned mod version (blank uses the newest stable)" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding Settings.PinnedModVersion, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Default configuration preset" Margin="0,8,0,4"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Settings.DefaultPreset}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Storage" FontSize="18"/>
                    <TextBlock Text="Backup folder" Margin="0,8,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseBackupCommand}"/>
                        <TextBox Text="{Binding Settings.BackupDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="Update cache" Margin="0,8,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCacheCommand}"/>
                        <TextBox Text="{Binding Settings.CacheDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="Log retention (days)" Margin="0,8,0,4"/>
                    <TextBox Text="{Binding Settings.LogRetentionDays}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance and logging" FontSize="18"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme}" Margin="0,8,0,8"/>
                    <CheckBox Content="Write diagnostic logs" IsChecked="{Binding Settings.DiagnosticLogging}"/>
                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
